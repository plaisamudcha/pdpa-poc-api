NODE_ENV=development
HOST_API_PORT=3041
ALLOW_ORIGIN=http://localhost:5173
# true เมื่อ deploy บน HTTPS เท่านั้น
COOKIE_SECURE=false
DATABASE_URL=mongodb://localhost:27017/pdpa_poc

# สร้างด้วย: bun run gen-keys  (POC เท่านั้น — production เก็บใน KMS / Vault)
# KEK หลายเวอร์ชันได้ (KEK_V1, KEK_V2, ...) KEK_CURRENT = เวอร์ชันที่ใช้ wrap DEK ใหม่
KEK_V1=
KEK_CURRENT=v1
BLIND_INDEX_KEY=
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=8
# รหัสผ่านของบัญชี support01 / admin01 / dpo01 ที่สร้างด้วย bun run seed-staff
SEED_STAFF_PASSWORD=

# ระยะเวลาเก็บข้อมูล (วัน) ก่อน job ลบอัตโนมัติ
RETENTION_DAYS=1825
