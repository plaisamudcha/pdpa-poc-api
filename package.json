{
  "name": "pdpa-poc-api",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file=.env run src/index.ts",
    "start": "bun --env-file=.env run src/index.ts",
    "check": "tsc --noEmit",
    "gen-keys": "bun run scripts/genKeys.ts",
    "seed-staff": "bun --env-file=.env run scripts/seedStaff.ts",
    "rotate-kek": "bun --env-file=.env run scripts/rotateKek.ts",
    "rebuild-search-idx": "bun --env-file=.env run scripts/rebuildSearchIdx.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "~9.4.1",
    "mongoose-lean-virtuals": "^2.1.0",
    "morgan": "^1.10.1",
    "zod": "^4.1.13"
  },
  "overrides": {
    "bson": "7.2.0"
  },
  "prettier": {
    "printWidth": 150,
    "singleQuote": true
  }
}
